{
  "name": "dennis-layout-statistik",
  "main": "layout-worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "routes": [
    { "pattern": "dennisagerblad.dk/_stats/*", "zone_name": "dennisagerblad.dk" },
    { "pattern": "www.dennisagerblad.dk/_stats/*", "zone_name": "dennisagerblad.dk" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "dennis-layout-statistik", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ],
  "secrets": { "required": ["REPORT_PASSWORD"] }
}
